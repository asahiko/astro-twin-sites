---
// Pagefind's index exists only after `npm run build` (pagefind --site dist), so dev shows a notice.
import { langPaths, type Lang } from "@twin/kit/i18n";
import Base from "../../layouts/Base.astro";
import { UI } from "../../lib/labels";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const dev = import.meta.env.DEV;
---
<Base lang={lang} title={UI[lang].search}>
  <h1>{UI[lang].search}</h1>
  {dev ? (
    <p class="notice">Search works only on a production build: <code>npm run build && npm run preview</code>.</p>
  ) : (
    <>
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <div id="search" data-pagefind-ignore></div>
      <script is:inline src="/pagefind/pagefind-ui.js"></script>
      <script is:inline>
        const ui = new PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
        const q = new URLSearchParams(location.search).get("q");
        if (q) ui.triggerSearch(q);
      </script>
    </>
  )}
</Base>
